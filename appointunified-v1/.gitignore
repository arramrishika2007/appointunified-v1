# --- IDE / Editor ---
.idea/
.vscode/
*.iml
*.iws
*.ipr

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Env / secrets ---
.env
.env.*
.env.local
.env.*.local
backend/.env
backend/.env.*
frontend/.env
