# --- TypeScript incremental build info ---
frontend/*.tsbuildinfo
*.tsbuildinfo

# --- Misc temp/cache ---
tmp/
temp/
.cache/

# Keep committed sample envs
!.env.example
!backend/.env.example
!frontend/.env.example
