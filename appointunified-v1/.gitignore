frontend/.env.local
*.pem
*.key
*.p12
*.jks
*.keystore
*.crt
*.cer
*.pfx
id_rsa
id_dsa
id_ed25519

# --- Logs / runtime files ---
*.log
*.pid
*.pid.lock
*.seed
*.stackdump
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java / Spring Boot (Gradle + Maven) ---
backend/.gradle/
backend/build/
backend/target/
backend/out/
backend/bin/
