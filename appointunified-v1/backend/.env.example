# ─── JWT ────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=c4aa+248fh6Dn0FBvUpnvzbv7odo1NRtA5O9sj7OKwiKhsbOyf17saWaKwC+43801QDQ+mRCXsnTIXPPKJfBYA==
