# Development Environment Variables
# Mirrors the Neon-backed runtime config used by the backend.

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-key-this-is-just-for-development-and-testing-purposes-only-min-32-chars-required
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=2592000000

# ─── Database ─────────────────────────────────────────────────────────────────
NEON_DATABASE_URL=jdbc:postgresql://ep-bitter-haze-anl1qedj-pooler.c-6.us-east-1.aws.neon.tech/neondb?user=neondb_owner&password=npg_d1tLu6UoXBsl&sslmode=require&channel_binding=require

# ─── Firebase (Optional - not needed for basic testing) ──────────────────────
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# ─── Redis (Optional) ─────────────────────────────────────────────────────────
REDIS_URL=

# ─── SendGrid / Email (Optional) ──────────────────────────────────────────────
SENDGRID_API_KEY=
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=noreply@appointunified.local
MAIL_FROM_NAME=AppointUnified Dev

# ─── Cloudinary (Optional) ────────────────────────────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=appointunified_docs
CLOUDINARY_MAX_FILE_SIZE_MB=2

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
